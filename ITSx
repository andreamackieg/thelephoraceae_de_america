#Para generar dos archivos fasta distintos (uno para cada marcador) y eliminar las secuencias cortas (menores a 350 pb)

python3 << 'EOF'
from Bio import SeqIO

seqs = {r.id: r for r in SeqIO.parse(
    "/home/andrea/Documentos/secuencias_finales/secuencias_filtradas.fasta", "fasta")}

its_records = []
lsu_records = []
its_cortas = 0
lsu_cortas = 0
sin_its = 0
sin_lsu = 0

with open("/home/andrea/Documentos/secuencias_finales/itsx_out.positions.txt") as f:
    for line in f:
        parts = line.strip().split("\t")
        if len(parts) < 2:
            continue

        seq_id = parts[0]
        info = "\t".join(parts[1:])

        if seq_id not in seqs:
            continue

        seq = seqs[seq_id]

        # Extraer ITS (ITS1 + 5.8S + ITS2, solo >= 350 pb)
        its1_start = its2_end = None
        for campo in info.split("\t"):
            campo = campo.strip()
            if campo.startswith("ITS1:") and "Not found" not in campo:
                its1_start = int(campo.replace("ITS1:", "").strip().split("-")[0]) - 1
            if campo.startswith("ITS2:") and "Not found" not in campo:
                its2_end = int(campo.replace("ITS2:", "").strip().split("-")[1])

        if its1_start is not None and its2_end is not None:
            its_seq = seq[its1_start:its2_end]
            if len(its_seq) >= 350:
                its_seq.id = seq.id
                its_seq.name = ""
                its_seq.description = seq.description
                its_records.append(its_seq)
            else:
                its_cortas += 1
        else:
            sin_its += 1

        # Extraer LSU (solo >= 350 pb)
        lsu_start = lsu_end = None
        for campo in info.split("\t"):
            campo = campo.strip()
            if campo.startswith("LSU:") and "Not found" not in campo:
                lsu_start = int(campo.replace("LSU:", "").strip().split("-")[0]) - 1
                lsu_end = int(campo.replace("LSU:", "").strip().split("-")[1])

        if lsu_start is not None and lsu_end is not None:
            lsu_seq = seq[lsu_start:lsu_end]
            if len(lsu_seq) >= 350:
                lsu_seq.id = seq.id
                lsu_seq.name = ""
                lsu_seq.description = seq.description
                lsu_records.append(lsu_seq)
            else:
                lsu_cortas += 1
        else:
            sin_lsu += 1

SeqIO.write(its_records, "/home/andrea/Documentos/secuencias_finales/solo_ITS.fasta", "fasta")
SeqIO.write(lsu_records, "/home/andrea/Documentos/secuencias_finales/LSU.fasta", "fasta")

print(f"Total secuencias procesadas: {len(its_records) + its_cortas + sin_its}")
print(f"✔ solo_ITS.fasta  → {len(its_records)} secuencias")
print(f"  ITS descartadas (<350 pb): {its_cortas}")
print(f"  Sin ITS detectado: {sin_its}")
print(f"✔ LSU.fasta       → {len(lsu_records)} secuencias")
print(f"  LSU descartadas (<350 pb): {lsu_cortas}")
print(f"  Sin LSU detectado: {sin_lsu}")
EOF
