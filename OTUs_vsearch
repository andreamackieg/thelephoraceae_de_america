#!/bin/bash
# ============================================================
# OTU clustering con VSEARCH
# Script desarrollado por Andrea Mackie Greene
# Asignación de OTUs a partir de secuencias ambientales (FASTA)
# Herramienta: vsearch v2.30.6
# Uso: ./otu_vsearch_pipeline.sh
# ============================================================

set -euo pipefail

# --- Parámetros ---
INPUT="/home/andrea/Documentos/secuencias_finales/solo_ITS.fasta"
OUTDIR="/home/andrea/Documentos/OTUs_98"
IDENTITY=0.98
PREFIX="Thelephoraceae_OTU"

# --- Función de logging ---
log() {
    local level="$1"; shift
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*"
}

# --- Verificar dependencias ---
if ! command -v vsearch &>/dev/null; then
    log ERROR "vsearch no encontrado. Verifica que esté instalado y en el PATH."
    exit 1
fi

if [[ ! -f "$INPUT" ]]; then
    log ERROR "Archivo de entrada no encontrado: $INPUT"
    exit 1
fi

mkdir -p "$OUTDIR"

log INFO "Iniciando clustering OTU con VSEARCH..."
log INFO "Archivo de entrada  : $INPUT"
log INFO "Directorio de salida: $OUTDIR"
log INFO "Identidad           : $IDENTITY"
log INFO "Prefijo de salida   : $PREFIX"

# --- 1. Clustering de novo (sin --relabel para conservar títulos originales) ---
log INFO "Ejecutando clustering..."
vsearch --cluster_fast "$INPUT" \
    --id "$IDENTITY" \
    --centroids "$OUTDIR/${PREFIX}_centroids.fasta" \
    --uc "$OUTDIR/${PREFIX}_clusters.uc"

log INFO "Clustering terminado. Centroides en: $OUTDIR/${PREFIX}_centroids.fasta"

# --- 2. Generar tabla OTU con numeración y título original ---
log INFO "Generando tabla de asignación OTU..."

# Primero construir diccionario: centroide -> OTU_N (en orden de aparición)
# Luego asignar a cada secuencia (S y H) su OTU correspondiente
awk 'BEGIN {OFS="\t"; print "Secuencia\tOTU"; n=0}
     $1 == "S" {
         n++
         otu[$9] = "OTU_" n
         print $9, "OTU_" n
     }
     $1 == "H" {
         print $9, otu[$10]
     }' \
    "$OUTDIR/${PREFIX}_clusters.uc" > "$OUTDIR/${PREFIX}_OTU_table.tsv"

log INFO "Tabla de asignación generada: $OUTDIR/${PREFIX}_OTU_table.tsv"

# --- 3. Agregar etiqueta _OTUx al header de los centroides ---
log INFO "Etiquetando centroides con su OTU asignada..."

awk 'NR==FNR {
         if (NR>1) otu[$1]=$2
         next
     }
     /^>/ {
         id=substr($1,2)
         if (id in otu) print ">" id "_" otu[id]
         else print $0
         next
     }
     { print }' \
    "$OUTDIR/${PREFIX}_OTU_table.tsv" \
    "$OUTDIR/${PREFIX}_centroids.fasta" \
    > "$OUTDIR/${PREFIX}_centroids_etiquetados.fasta"

log INFO "Centroides etiquetados en: $OUTDIR/${PREFIX}_centroids_etiquetados.fasta"

# --- 4. Resumen ---
n_otus=$(grep -c "^>" "$OUTDIR/${PREFIX}_centroids.fasta")
n_seqs=$(awk '$1 == "S" || $1 == "H"' "$OUTDIR/${PREFIX}_clusters.uc" | wc -l)

log INFO "OTUs generados              : $n_otus"
log INFO "Secuencias totales asignadas: $n_seqs"
log INFO "Proceso completo."
